# ===== 접속 주소 =====
# 로컬: http://localhost
# 운영: 도메인만 적으면 Caddy 가 HTTPS 인증서를 자동 발급한다. (예: mylive.duckdns.org)
SITE_ADDRESS=http://localhost

# WebRTC 미디어가 오갈 서버 주소. 로컬은 127.0.0.1, 운영은 서버 공인 IP
PUBLIC_HOST=127.0.0.1

# HTTPS 로 운영할 때 true (Refresh Token 쿠키에 Secure 속성)
COOKIE_SECURE=false

# ===== 비밀 값 (scripts/generate-env.sh 로 자동 생성 가능, 절대 커밋하지 말 것) =====
POSTGRES_PASSWORD=change-me-postgres
JWT_SECRET=change-me-at-least-32-bytes-random-string-0000
INTERNAL_API_KEY=change-me-internal-key

# ===== 평가용 테스트 계정 (tester1, tester2) =====
TEST_ACCOUNTS_ENABLED=true
TEST_ACCOUNT_PASSWORD=test1234!

# ===== 토스페이먼츠 테스트 키 (https://developers.tosspayments.com 에서 발급) =====
# API 개별 연동 키의 "테스트" 키를 사용한다. test_ck_ 로 시작하는 클라이언트 키, test_sk_ 로 시작하는 시크릿 키
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 방송 중 송출이 이 시간 이상 끊기면 자동 종료
STREAM_STALE_GRACE=3m
